// Garcar Enterprise — Shopify App
// Prisma Schema — Stripe MRR Pipeline Edition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Shopify OAuth Sessions ───────────────────────────────────────────────────
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ── Merchant Subscriptions ───────────────────────────────────────────────────
model MerchantSubscription {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  plan                 String   @default("starter")
  status               String   @default("active")
  stripeId             String?
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

// ── Revenue Events (Stripe webhook payloads) ─────────────────────────────────
// Every paid event from Stripe lands here with idempotency via stripeEventId.
// Refunds are written as negative amountCents to offset MRR naturally.
model RevenueEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique          // idempotency key
  eventType     String                    // checkout.session.completed | invoice.payment_succeeded | ...
  amountCents   Int                       // in smallest currency unit; negative for refunds
  currency      String   @default("USD")
  customerId    String?
  customerEmail String?
  productName   String?
  metadata      String?                   // JSON blob of Stripe metadata
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([customerId])
}

// ── MRR Snapshots ────────────────────────────────────────────────────────────
// Computed snapshots written by the MRR reconciliation job (GitHub Actions cron).
// Used for trend data on the dashboard sparklines.
model MrrSnapshot {
  id          String   @id @default(cuid())
  snapshotAt  DateTime @default(now())
  mrrCents    Int                           // total MRR in cents for that period
  subCount    Int      @default(0)          // active subscription count
  period      String                        // e.g. "2026-04"

  @@unique([period])
  @@index([snapshotAt])
}

// ── Churn Signals ────────────────────────────────────────────────────────────
model ChurnSignal {
  id          String   @id @default(cuid())
  shop        String
  riskScore   Float
  signals     String   // JSON array of churn indicators
  predictedAt DateTime @default(now())

  @@index([shop])
  @@index([riskScore])
}
